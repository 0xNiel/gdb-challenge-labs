# Every environment variable the system reads. Copy to `.env` for local dev (ignored by git)
# or to /etc/labd/labd.env and /etc/web/web.env on the box (root:group 0640).
# Generate real secrets with scripts/gen-secrets.sh (Phase 8). Never commit real values.

# --- shared -----------------------------------------------------------------
# Per-deploy secret behind every flag (ADR 0005). Rotating it invalidates all writeups
# and requires rebuilding every challenge image.
DEPLOY_SECRET=change-me-32-random-bytes-base64
# Bearer token web → labd internal API (S11).
LABD_INTERNAL_SECRET=change-me
# HMAC key for WebSocket tokens, shared by web (mint) and labd (verify) (S12).
WS_TOKEN_KEY=change-me
# Public host, used by Caddy, the WebSocket Origin check and allauth.
SITE_HOST=labs.example.com

# --- labd -------------------------------------------------------------------
LABD_CONFIG=/etc/labd/labd.yaml
LABD_POSTGRES_DSN=postgres://labd:labd@127.0.0.1:5432/labs
# Read-only GHCR fine-grained PAT for pulling challenge images; lives in /etc/labd/ghcr.env.
GHCR_NAMESPACE=<org>
GHCR_USERNAME=<github-user>
GHCR_TOKEN=<read-only-pat>

# --- web --------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://web:web@127.0.0.1:5432/labs
LABD_INTERNAL_URL=http://127.0.0.1:8081
# Where the browser opens the terminal WebSocket (ws(s)://host). Empty in production: the
# page's own host, which Caddy routes to labd. Dev: ws://127.0.0.1:8082 (scripts/web-stack.sh).
LABD_WS_BASE=
# Path to the checked-out repo so import_challenges can read lesson.md / solution.md.
CHALLENGES_REPO=/srv/labbing-platform
# Email (Phase 8; provider undecided, see QUESTIONS.md Q4).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=labs@example.com

# --- backups (Phase 8) ------------------------------------------------------
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# --- dev only ---------------------------------------------------------------
# Lets the manifest schema accept local/ image refs written by dev-mode challenge builds.
ALLOW_LOCAL_IMAGES=1
# Name of the Lima VM used by run.sh.
LABS_VM=labs
# LIMA_ARCH=x86_64 to run the dev VM under emulation.
