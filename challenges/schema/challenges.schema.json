{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdb-labs/challenges/schema/challenges.schema.json",
  "title": "challenges.json: the import artifact for labd (images, limits) and web (curriculum)",
  "description": "Generated by scripts/challenges-json.sh from challenges/tier*/*/manifest.yaml, sorted by tier then order. A challenge without a pushed image is disabled; labd ignores it. lesson_path and solution_path are relative to the repository root; web reads them from its checkout.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated_at", "challenges"],
  "properties": {
    "version": {"type": "integer", "minimum": 1, "maximum": 1},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "tier", "order", "difficulty", "estimated_minutes", "image", "limits", "hints", "tags", "boss", "enabled", "lesson_path", "solution_path"],
        "properties": {
          "slug": {"type": "string", "pattern": "^tier[1-9]-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "tier": {"type": "integer", "minimum": 1, "maximum": 9},
          "order": {"type": "integer", "minimum": 1, "maximum": 99},
          "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
          "estimated_minutes": {"type": "integer", "minimum": 1},
          "image": {"type": "string", "pattern": "^$|^ghcr\\.io/[a-z0-9-]+/lab-[a-z0-9-]+@sha256:[a-f0-9]{64}$|^local/lab-[a-z0-9-]+@sha256:[a-f0-9]{64}$"},
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["memory_mb", "cpu_millicores", "pids", "ttl_minutes", "idle_minutes", "extend_minutes"],
            "properties": {
              "memory_mb": {"type": "integer", "minimum": 32, "maximum": 1024},
              "cpu_millicores": {"type": "integer", "minimum": 100, "maximum": 2000},
              "pids": {"type": "integer", "minimum": 4, "maximum": 32},
              "ttl_minutes": {"type": "integer", "minimum": 5},
              "idle_minutes": {"type": "integer", "minimum": 1},
              "extend_minutes": {"type": "integer", "minimum": 0}
            }
          },
          "hints": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cost", "text"],
              "properties": {"cost": {"type": "integer", "minimum": 0, "maximum": 3}, "text": {"type": "string", "minLength": 1}}
            }
          },
          "tags": {"type": "array", "items": {"type": "string"}},
          "boss": {"type": "boolean"},
          "enabled": {"type": "boolean"},
          "lesson_path": {"type": "string", "pattern": "^challenges/.+/lesson\\.md$"},
          "solution_path": {"type": "string", "pattern": "^challenges/.+/solution\\.md$"}
        }
      }
    }
  }
}
